# Copy to .env, replace the marked values, and source it before running Django.
# Generate a fresh key with: openssl rand -hex 32
DJANGO_SECRET_KEY=replace-this-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOGIN_URL=/login/

# Match these values when creating the local PostgreSQL role and database.
DB_NAME=ticket_management
DB_USER=ticket_app
DB_PASSWORD=replace-this-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis is used by Celery and Channels. Keep it bound to localhost for local use.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CHANNEL_REDIS_HOST=127.0.0.1
CHANNEL_REDIS_PORT=6379
CELERY_TIMEZONE=UTC
